# syntax=docker/dockerfile:1
FROM rust:1-slim AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY server/Cargo.toml server/
COPY leaderboard/Cargo.toml leaderboard/
COPY game/Cargo.toml game/
RUN mkdir -p game/src && echo "fn main(){}" > game/src/main.rs && \
    cargo build --release -p evox-master && rm -rf target/release/deps/evox*
COPY server/src server/src
RUN cargo build --release -p evox-master

FROM debian:bookworm-slim
RUN useradd -r -u 10001 evox
COPY --from=build /src/target/release/evox-master /usr/local/bin/evox-master
USER evox
EXPOSE 8790
ENTRYPOINT ["/usr/local/bin/evox-master"]
